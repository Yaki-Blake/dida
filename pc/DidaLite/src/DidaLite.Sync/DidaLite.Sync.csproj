<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立同步服务：给服务器（Linux）跑的版本，不依赖 WPF、不依赖 .NET 运行时（发布时自包含）。
    协议与桌面端内嵌的 5080 完全一致，手机端不用改一行。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dida-sync</AssemblyName>
    <RootNamespace>DidaLite.Sync</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DidaLite.Core\DidaLite.Core.csproj" />
    <ProjectReference Include="..\DidaLite.Data\DidaLite.Data.csproj" />
  </ItemGroup>

</Project>

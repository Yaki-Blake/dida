<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DidaLite.Core\DidaLite.Core.csproj" />
    <ProjectReference Include="..\DidaLite.Data\DidaLite.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- 内嵌同步 API（/sync），只监听本机 5080 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 桌面图标与手机端同源：纸色底 + 表盘环 + 对勾 -->
  <PropertyGroup>
    <ApplicationIcon>Assets\dida.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dida.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 发布时预编译（ReadyToRun），省掉冷启动的 JIT -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>

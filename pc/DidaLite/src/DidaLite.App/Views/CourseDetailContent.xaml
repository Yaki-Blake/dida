<UserControl x:Class="DidaLite.App.Views.CourseDetailContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 课程详情的内容本体：课表页右侧卡片和主界面日视图右侧面板共用这一份，
         DataContext 都是 ScheduleViewModel（字段与备注读写都在它那里）。
         关闭按钮走 CloseCommand：课表页关自己的卡片，主界面关右侧面板。 -->
    <UserControl.Resources>
        <!-- 本控件被课表页卡片和主界面右侧面板共用，两处各自的资源字典里不一定有转换器，
             所以这里自带一份，不依赖宿主 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 备注卡片的只读态：整块可点，点进去就地编辑 -->
        <Style x:Key="NoteCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg-app}" />
            <Setter Property="BorderBrush" Value="{DynamicResource line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 标题行：课程名 + 关闭。备注放在它下面，一打开就能看见，不用滚到底部 -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="关闭"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Text="{Binding DetailName}"
                           Style="{StaticResource SectionTitle}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Margin="0,0,10,0" />
            </DockPanel>

            <!-- ============ 备注区：放在最上面，所见即所得 ============ -->

            <!-- 长期备注：这门课所有课次共用 -->
            <Border x:Name="LongNoteCard" Style="{StaticResource NoteCard}" Margin="0,0,0,8">

                <StackPanel>
                    <TextBlock Text="长期备注" FontSize="{StaticResource FontSize11}"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource text-secondary}" />

                    <!-- 只读态：直接读出正文；没写过就给一句可点的提示 -->
                    <TextBlock Text="{Binding LongNoteDisplay}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize13}"
                               LineHeight="19"
                               MaxHeight="112"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NoteText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource text-primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LongNoteIsEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource text-tertiary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 编辑态：输入框 + 保存 / 取消。整套只在编辑时占位，不编辑时不影响布局 -->
                    <StackPanel Visibility="{Binding IsEditingLongNote, Converter={StaticResource BoolToVis}}"
                                Margin="0,6,0,0">
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                                 VerticalScrollBarVisibility="Auto" Padding="8"
                                 FontSize="{StaticResource FontSize13}"
                                 Background="{DynamicResource bg-surface}"
                                 Foreground="{DynamicResource text-primary}"
                                 BorderBrush="{DynamicResource line}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="清除" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearNoteCommand}" Margin="0,0,6,0"
                                    Padding="8,3" FontSize="{StaticResource FontSize11}" />
                            <Button Content="取消" Style="{StaticResource GhostButton}"
                                    Command="{Binding CancelLongNoteCommand}" Margin="0,0,6,0"
                                    Padding="8,3" FontSize="{StaticResource FontSize11}" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveNoteCommand}"
                                    Padding="10,3" FontSize="{StaticResource FontSize11}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding NoteHint}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoteHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 单次备注：只这一天这一次课 -->
            <Border x:Name="OnceNoteCard" Style="{StaticResource NoteCard}" Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="单次备注" FontSize="{StaticResource FontSize11}"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource text-secondary}" />

                    <TextBlock Text="{Binding OnceNoteDisplay}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize13}"
                               LineHeight="19"
                               MaxHeight="92"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OnceNoteText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource text-primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OnceNoteIsEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource text-tertiary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding IsEditingOnceNote, Converter={StaticResource BoolToVis}}"
                                Margin="0,6,0,0">
                        <TextBox Text="{Binding OnceNoteText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                 VerticalScrollBarVisibility="Auto" Padding="8"
                                 FontSize="{StaticResource FontSize13}"
                                 Background="{DynamicResource bg-surface}"
                                 Foreground="{DynamicResource text-primary}"
                                 BorderBrush="{DynamicResource line}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="清除" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearOnceNoteCommand}" Margin="0,0,6,0"
                                    Padding="8,3" FontSize="{StaticResource FontSize11}" />
                            <Button Content="取消" Style="{StaticResource GhostButton}"
                                    Command="{Binding CancelOnceNoteCommand}" Margin="0,0,6,0"
                                    Padding="8,3" FontSize="{StaticResource FontSize11}" />
                            <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveOnceNoteCommand}"
                                    Padding="10,3" FontSize="{StaticResource FontSize11}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding OnceNoteHint}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OnceNoteHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 课程信息在备注之后：备注是打开详情后最想先看到的东西 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="时间"
                           Style="{StaticResource HintText}" VerticalAlignment="Top"
                           Margin="0,2,0,8" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding DetailDate}"
                               FontSize="{StaticResource FontSize13}"
                               Foreground="{DynamicResource text-primary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding DetailClock}"
                               FontSize="{StaticResource FontSize13}"
                               Foreground="{DynamicResource text-secondary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="节次"
                           Style="{StaticResource HintText}" VerticalAlignment="Top"
                           Margin="0,2,0,8" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding DetailPeriodName}"
                               FontSize="{StaticResource FontSize13}"
                               Foreground="{DynamicResource text-primary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding DetailWeekName}"
                               FontSize="{StaticResource FontSize13}"
                               Foreground="{DynamicResource text-secondary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="地点"
                           Style="{StaticResource HintText}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailRoom}"
                           FontSize="{StaticResource FontSize13}"
                           Foreground="{DynamicResource text-primary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="授课老师"
                           Style="{StaticResource HintText}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailTeacher}"
                           FontSize="{StaticResource FontSize13}"
                           Foreground="{DynamicResource text-primary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="上课周次"
                           Style="{StaticResource HintText}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailWeeks}"
                           FontSize="{StaticResource FontSize13}"
                           Foreground="{DynamicResource text-primary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

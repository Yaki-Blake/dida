<Window x:Class="DidaLite.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource bg-surface}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12"
            Effect="{DynamicResource OverlayShadow}">
        <StackPanel Margin="16">
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource SectionTitle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DueText"
                       Style="{StaticResource MetaText}"
                       Margin="0,6,0,0" />
            <TextBlock x:Name="NoteText"
                       Style="{StaticResource MetaText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="完成" Style="{StaticResource PrimaryButton}" Click="OnComplete" />
                <Button Content="推迟 10 分钟" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSnoozeTen" />
                <Button Content="推迟 1 天" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSnoozeDay" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnDismiss" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

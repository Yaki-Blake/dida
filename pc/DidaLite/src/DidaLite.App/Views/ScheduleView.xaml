<UserControl x:Class="DidaLite.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DidaLite.App.Converters"
             xmlns:views="clr-namespace:DidaLite.App.Views"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 课程配色：按课程名取色，同一门课永远同一个颜色，不同课程颜色不同。
             与浏览器端课表页（schedule_page.html 的 hue()）同一套算法，
             所以桌面、网页、手机三端的「高等数学 I」是同一个色相。 -->
        <conv:CourseFillConverter x:Key="CourseFill" />
        <conv:CourseStrokeConverter x:Key="CourseStroke" />

        <!-- 一格里的课程卡片：铺满整格、四角圆润、底色按课程取色。
             格子本身有 2px 内边距（见 SlotCell），卡片贴着内边距撑满，
             相邻课程块之间自然留出一条缝，不会糊成一片。 -->
        <DataTemplate x:Key="CourseCard">
            <Border Background="{Binding Name, Converter={StaticResource CourseFill}}"
                    BorderBrush="{Binding Name, Converter={StaticResource CourseStroke}}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="{StaticResource RadiusM}"
                    Padding="6,4" Margin="0"
                    VerticalAlignment="Stretch"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonUp="CourseCard_Click"
                    ToolTip="{Binding WeeksExpr}">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <!-- 两种备注两个标记：实心点 = 这门课的长期备注（每次课都有），
                             空心圈 = 只属于这一次课的单次备注。悬停有说明。
                             颜色跟着这门课走，不再统一用主题绿。 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="6,0,2,0">
                            <Ellipse Width="6" Height="6"
                                     Fill="{Binding Name, Converter={StaticResource CourseStroke}}"
                                     Margin="0,0,3,0"
                                     ToolTip="有长期备注（本课所有课次）"
                                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="6" Height="6"
                                     Stroke="{Binding Name, Converter={StaticResource CourseStroke}}"
                                     StrokeThickness="1.5"
                                     ToolTip="有单次备注（仅这一次课）"
                                     Visibility="{Binding HasOnceNote, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSize12}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource text-primary}"
                                   ToolTip="{Binding Name}" />
                    </DockPanel>
                    <!-- 教室只显示「教学楼名 + 房号」：教务系统给的原文带楼栋代码
                         （笃行楼(SJ2)419）或实验室说明（拓新楼205（计算机基础实验室）），
                         窄列下这些会把房号挤掉。RoomShort 去掉括号内容，
                         原文仍留在 ToolTip 里，悬停能看全。 -->
                    <TextBlock Text="{Binding RoomShort}"
                               FontSize="{StaticResource FontSize11}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource text-secondary}"
                               ToolTip="{Binding Room}" />
                    <!-- 教师单独一行：原来跟在时间后 "08:30–10:00 · 老师名"，
                         窄列下 CharacterEllipsis 会把末尾的教师名整段截掉。
                         时间段左侧节次列已有，卡片上不再重复，换成教师独占一行。 -->
                    <TextBlock Text="{Binding Teacher}"
                               FontSize="{StaticResource FontSize11}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource text-tertiary}"
                               ToolTip="{Binding Teacher}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SlotCell">
            <Border BorderBrush="{DynamicResource line}"
                    BorderThickness="0,0,1,1"
                    Padding="2,2">
                <!-- 一格里有多门课（如单/双周）时纵向均分：UniformGrid 把格子等分给
                     每张卡片，卡片再各自撑满自己那一份，块与块之间只留格子那 2px 内边距。 -->
                <ItemsControl ItemsSource="{Binding Items}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              ItemTemplate="{StaticResource CourseCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- DataContext 由 MainWindow 首次创建时显式设为 MainViewModel.Schedule -->
    <Grid x:Name="RootLayout" Margin="8,0,8,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- 课表主体占满整行；详情栏浮在右侧，但它的宽度会同步给 7 天网格：
                 周六、周日两列合起来正好等于详情栏宽度，于是被它整块占掉，
                 周一到周五均分剩下的宽度（详见 WeekColumnsPanel）。 -->
            <ColumnDefinition x:Name="TimetableColumn" Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- 工具条：教学周导航与课表操作 -->
        <Grid Grid.Row="0" Margin="4,4,4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 翻周箭头：热区 46×44（原 38×36 偏小不好点）。
                     字形用实心三角而不是 ‹ ›：细长的书引号在中文字体下又小又淡，
                     实心三角在同样字号下更醒目，一眼就知道能翻周。 -->
                <Button x:Name="PreviousWeekButton" Content="◀" Style="{StaticResource GhostButton}"
                        Width="46" Height="44" Padding="0"
                        FontSize="{StaticResource FontSize14}"
                        Command="{Binding PreviousWeekCommand}" ToolTip="上一周" />
                <ComboBox x:Name="WeekSelector" Style="{StaticResource SelectComboBox}"
                          Width="64" Height="44"
                          ItemsSource="{Binding Weeks}" SelectedItem="{Binding Week}"
                          Margin="4,0" />
                <Button x:Name="NextWeekButton" Content="▶" Style="{StaticResource GhostButton}"
                        Width="46" Height="44" Padding="0"
                        FontSize="{StaticResource FontSize14}"
                        Command="{Binding NextWeekCommand}" ToolTip="下一周" />
                <Button Content="本周" Style="{StaticResource GhostButton}"
                        Height="44" Margin="12,0,0,0" Padding="14,0"
                        Command="{Binding GoCurrentWeekCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SyncButton" Content="一键同步"
                        Style="{StaticResource PrimaryButton}"
                        Click="Sync_Click" Margin="0,0,8,0"
                        ToolTip="从教务系统同步课表" />
                <Button Content="导入课表" Style="{StaticResource GhostButton}"
                        Click="Import_Click" Margin="0,0,8,0"
                        ToolTip="导入 .ics 或 .json" />
                <Button Content="清空" Style="{StaticResource GhostButton}"
                        Click="Clear_Click"
                        ToolTip="清空课表，保留备注" />
            </StackPanel>
        </Grid>

        <!-- 课表主体：左侧节次列与右侧 7×6 网格共用同一行高。
             整块放进 ScrollViewer：窗口放不下时手动上下滑动，表头随内容一起滚。

             「每个块上下太高」有两层原因，两层都改了：
             1) 行高：原来 6 段写死 MinHeight="900"，一行就是 150。现在地板降到 432
                （一段 72，三行文字的实测高度），窗口矮时不再被顶到 150；
                仍然用 *，所以窗口高时网格继续铺满，下面不留空白。
             2) 块高：格子高 ≠ 块高。SlotCell 里原来是 UniformGrid + Stretch，
                卡片被硬拉成整格那么高，150 的格子里只有 3 行字，剩下全是同色底——
                这就是看到的那个「大块」。现在卡片按内容收拢、在格子里垂直居中。 -->
        <!-- 空白处可点：ScrollViewer 与格子都没 Background，WPF 里没背景的元件不吃命中，
             点在没有课程的空档上事件根本不会走到这里，「点空白收起」就形同虚设。
             给滚动区铺一层 Transparent：不吃视觉、只负责接住空白处的点击。 -->
        <ScrollViewer x:Name="WeekScroll" Grid.Row="1"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="WeekGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="432" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PeriodColumn" Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource bg-surface}"
                    BorderBrush="{DynamicResource line}" BorderThickness="0,0,1,1" />

            <ItemsControl x:Name="HeaderRow" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Headers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 表头与课表主体共用同一套列宽规则：周末两列正好让给右侧课程详情栏。
                             绑到 UserControl 上的 WeekendColumnWidth，面板被重建也不会丢 -->
                        <views:WeekColumnsPanel Rows="1" Columns="7"
                                                WeekendWidth="{Binding WeekendColumnWidth,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource line}"
                                BorderThickness="0,0,1,1" Padding="4,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource bg-surface}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource accent-weak}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Periods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource line}"
                                BorderThickness="0,0,1,1" Padding="8,6">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSize12}"
                                           Foreground="{DynamicResource text-primary}" />
                                <TextBlock Text="{Binding Time}"
                                           FontFamily="{StaticResource NumericFont}"
                                           FontSize="{StaticResource FontSize11}"
                                           Foreground="{DynamicResource text-tertiary}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="1"
                          x:Name="CellGrid"
                          ItemsSource="{Binding Cells}"
                          ItemTemplate="{StaticResource SlotCell}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 与表头同款面板，Rows=6；周末两列宽度跟详情栏走 -->
                        <views:WeekColumnsPanel Rows="6" Columns="7"
                                                WeekendWidth="{Binding WeekendColumnWidth,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
        </ScrollViewer>

        <!-- 空态：还没有导入课表时盖住空白网格，给出明确入口 -->
        <Border x:Name="EmptyOverlay" Grid.Row="1" Panel.ZIndex="10"
                Background="{DynamicResource bg-surface}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="还没有课表"
                           Style="{StaticResource SectionTitle}"
                           Foreground="{DynamicResource text-secondary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 课程详情：浮在课表主体右上方的覆盖层，同时它的宽度会下发给 7 天网格。
             展开后周六、周日两列被它整块占掉（周末那两块本来就是空面积，不浪费），
             周一到周五则均分剩下的宽度——边栏越宽它们越窄，但位置与顺序不变。
             拖动条仍叠在卡片左边缘，拖它就是改这里的 Width，网格跟着重算。 -->
        <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Panel.ZIndex="20">
            <!-- 宽度默认 300（与主界面右侧详情一致），拖过之后按上次的宽度展开。
                 收起时 Visible=Collapsed，整层宽度归零，课表独占全宽。 -->
            <Border x:Name="CourseDetailCard"
                    Width="300" VerticalAlignment="Stretch"
                    Background="{DynamicResource bg-surface}"
                    BorderBrush="{DynamicResource line}" BorderThickness="1,0,0,0"
                    Padding="20,16"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
                    IsVisibleChanged="CourseDetailCard_IsVisibleChanged"
                    SizeChanged="CourseDetailCard_SizeChanged">
                <views:CourseDetailContent CloseCommand="{Binding CloseDetailCommand}" />
            </Border>

            <!-- 拖动条叠在卡片左边缘（负 margin 居中），不额外占课表宽度；
                 向左拖变宽、向右拖变窄，Esc / 关闭按钮收起 -->
            <Thumb x:Name="DetailSplitter"
                   HorizontalAlignment="Left" Width="10" Margin="-5,0,0,0"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   AutomationProperties.AutomationId="DetailSplitter"
                   Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
                   DragStarted="DetailSplitter_DragStarted"
                   DragDelta="DetailSplitter_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Grip" Width="2" Height="36"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="1" Background="{DynamicResource line}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="DidaLite.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 一格里的课程卡片：与日视图时间轴上的日程块同一套配色 -->
        <DataTemplate x:Key="CourseCard">
            <Border Background="{DynamicResource accent-weak}"
                    BorderBrush="{DynamicResource accent}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="{StaticResource RadiusS}"
                    Padding="6,4" Margin="0,0,0,2"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonUp="CourseCard_Click"
                    ToolTip="{Binding WeeksExpr}">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="已备注"
                                   FontSize="{StaticResource FontSize11}"
                                   Foreground="{DynamicResource accent}"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="{StaticResource FontSize12}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource text-primary}"
                                   ToolTip="{Binding Name}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Room}"
                               FontSize="{StaticResource FontSize11}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource text-secondary}"
                               ToolTip="{Binding Room}" />
                    <TextBlock FontSize="{StaticResource FontSize11}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource text-tertiary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}–{1} · {2}">
                                <Binding Path="Start" />
                                <Binding Path="End" />
                                <Binding Path="Teacher" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SlotCell">
            <Border BorderBrush="{DynamicResource line}"
                    BorderThickness="0,0,1,1"
                    Padding="2,2">
                <!-- 一格里的课程尽量撑满格子：UniformGrid 会把每张卡片拉伸到单元格，
                     同一节有多门课（如单/双周）时纵向均分，不再挤在顶部留一大片空白 -->
                <ItemsControl ItemsSource="{Binding Items}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              ItemTemplate="{StaticResource CourseCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DayRow">
            <Border Background="{DynamicResource bg-surface}"
                    BorderBrush="{DynamicResource line}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8" Cursor="Hand"
                    MouseLeftButtonUp="DayRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}"
                                   FontFamily="{StaticResource NumericFont}"
                                   FontSize="{StaticResource FontSize13}"
                                   Foreground="{DynamicResource text-primary}" />
                        <TextBlock Text="{Binding PeriodText}"
                                   Style="{StaticResource HintText}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="已备注"
                                       FontSize="{StaticResource FontSize11}"
                                       Foreground="{DynamicResource accent}"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding Course.HasNote, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Course.Name}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource FontSize13}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource text-primary}" />
                        </DockPanel>
                        <TextBlock Text="{Binding MetaText}"
                                   Style="{StaticResource HintText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding WeeksText}"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContext 由 MainWindow 首次创建时显式设为 MainViewModel.Schedule -->
    <Grid x:Name="RootLayout" Margin="8,0,8,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- 课表主体：详情栏拖宽时至少留 300 给 7 天网格 -->
            <ColumnDefinition x:Name="TimetableColumn" Width="*" MinWidth="300" />
            <!-- 10px 拖动条，详情收起时整列跟内容一起归零 -->
            <ColumnDefinition Width="Auto" />
            <!-- 详情栏宽度写在 CourseDetailCard.Width 上，Auto 列自动跟随 -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 工具条：教学周导航 + 周/日切换 -->
        <Grid Grid.Row="0" Margin="4,4,4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 翻周箭头：外观仍是小箭头，但可点击热区放大到 38×36，方便鼠标/触屏点 -->
                <Button x:Name="PreviousWeekButton" Content="‹" Style="{StaticResource GhostButton}"
                        Width="38" Height="36" Padding="0"
                        FontSize="{StaticResource FontSize20}"
                        Command="{Binding PreviousWeekCommand}" ToolTip="上一周" />
                <ComboBox x:Name="WeekSelector" Style="{StaticResource SelectComboBox}" Width="60"
                          ItemsSource="{Binding Weeks}" SelectedItem="{Binding Week}"
                          Margin="2,0" ToolTip="选择教学周" />
                <Button x:Name="NextWeekButton" Content="›" Style="{StaticResource GhostButton}"
                        Width="38" Height="36" Padding="0"
                        FontSize="{StaticResource FontSize20}"
                        Command="{Binding NextWeekCommand}" ToolTip="下一周" />
                <!-- 日期范围与「本周」按钮不再单独占位；双击摘要即可回到本周 -->
                <Border x:Name="SummaryHotspot" Background="Transparent" Cursor="Hand"
                        VerticalAlignment="Center" Margin="10,0,0,0" Padding="6,4"
                        ToolTip="双击回到本周">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding GoCurrentWeekCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource HintText}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SyncButton" Content="一键同步"
                        Style="{StaticResource PrimaryButton}"
                        Click="Sync_Click" Margin="0,0,8,0"
                        ToolTip="每次都会打开本机的「同步助手」页：从助手里进教务课表页，点一下书签即可同步；装着油猴脚本时刷新课表页就自动完成（同步中点击可取消）" />
                <Button Content="导入课表" Style="{StaticResource GhostButton}"
                        Click="Import_Click" Margin="0,0,8,0"
                        ToolTip="选择浏览器书签导出的 .ics，或课表快照 .json；导入后立即生效" />
                <Button Content="清空" Style="{StaticResource GhostButton}"
                        Click="Clear_Click" Margin="0,0,8,0"
                        ToolTip="清空课表，可重新体验导入流程" />
                <ComboBox Style="{StaticResource SelectComboBox}" Width="88"
                          ItemsSource="{Binding DayLabels}"
                          SelectedIndex="{Binding SelectedDayIndex}"
                          Margin="0,0,8,0"
                          Visibility="{Binding IsDayTab, Converter={StaticResource BoolToVis}}" />
                <Border Background="{DynamicResource bg-surface}"
                        BorderBrush="{DynamicResource line}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusM}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="周" Style="{StaticResource SegmentButton}"
                                Tag="{Binding IsWeekTab}"
                                Command="{Binding ShowWeekTabCommand}" />
                        <Button Content="日" Style="{StaticResource SegmentButton}"
                                Tag="{Binding IsDayTab}"
                                Command="{Binding ShowDayTabCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 周视图：左侧节次列与右侧 7×6 网格共用同一行高 -->
        <Grid x:Name="WeekGrid" Grid.Row="1"
              Visibility="{Binding IsWeekTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource bg-surface}"
                    BorderBrush="{DynamicResource line}" BorderThickness="0,0,1,1" />

            <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Headers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource line}"
                                BorderThickness="0,0,1,1" Padding="4,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource bg-surface}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource accent-weak}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Periods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource line}"
                                BorderThickness="0,0,1,1" Padding="8,6">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="{StaticResource FontSize12}"
                                           Foreground="{DynamicResource text-primary}" />
                                <TextBlock Text="{Binding Time}"
                                           FontFamily="{StaticResource NumericFont}"
                                           FontSize="{StaticResource FontSize11}"
                                           Foreground="{DynamicResource text-tertiary}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding Cells}"
                          ItemTemplate="{StaticResource SlotCell}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- 日视图：选中那一天的课按时间排开 -->
        <Border Grid.Row="1"
                Background="{DynamicResource bg-surface}"
                BorderBrush="{DynamicResource line}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}"
                Visibility="{Binding IsDayTab, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,10">
                    <TextBlock Text="{Binding DayTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DaySummary}" Style="{StaticResource HintText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DayItems}"
                                  ItemTemplate="{StaticResource DayRow}" />
                </ScrollViewer>
            </Grid>
        </Border>
        <!-- 空态：还没有导入课表时盖住空白网格，给出明确入口 -->
        <Border x:Name="EmptyOverlay" Grid.Row="1" Panel.ZIndex="10"
                Background="{DynamicResource bg-surface}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="还没有课表数据"
                           Style="{StaticResource SectionTitle}"
                           Foreground="{DynamicResource text-secondary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点右上角「一键同步」用默认浏览器里已登录的教务账号获取，或「导入课表」选择 .ics / .json"
                           Style="{StaticResource HintText}" Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="「一键同步」每次都会打开「同步助手」，在助手里进教务课表页，点一下书签即可同步"
                           Style="{StaticResource HintText}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="想全自动可装助手页里的油猴脚本；同步后 5080 接口与 /schedule.ics 订阅同时生效"
                           Style="{StaticResource HintText}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 课程详情侧栏：点周视图卡片或日视图行从右侧展开，课表整体左移；左边缘可左右拖动改宽度 -->
        <!-- 与左侧导航栏同款拖动条：向左拖变宽、向右拖变窄，Esc / 关闭按钮收起 -->
        <Thumb x:Name="DetailSplitter" Grid.Column="1" Grid.RowSpan="2"
               Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="左右拖动调整详情栏宽度"
               AutomationProperties.AutomationId="DetailSplitter"
               Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
               DragStarted="DetailSplitter_DragStarted"
               DragDelta="DetailSplitter_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Grip" Width="2" Height="36"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource line}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Border x:Name="CourseDetailCard" Grid.Column="2" Grid.RowSpan="2"
                Width="252" VerticalAlignment="Stretch"
                Background="{DynamicResource bg-surface}"
                BorderBrush="{DynamicResource line}" BorderThickness="1,0,0,0"
                Padding="20,16"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="关闭"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CloseDetailCommand}" />
                        <TextBlock Text="{Binding DetailName}"
                                   Style="{StaticResource SectionTitle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,10,0" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="时间"
                                   Style="{StaticResource HintText}" VerticalAlignment="Top"
                                   Margin="0,2,0,8" />
                        <StackPanel x:Name="TimeLines" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DetailDate}"
                                       FontSize="{StaticResource FontSize13}"
                                       Foreground="{DynamicResource text-primary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding DetailClock}"
                                       FontSize="{StaticResource FontSize13}"
                                       Foreground="{DynamicResource text-secondary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="节次"
                                   Style="{StaticResource HintText}" VerticalAlignment="Top"
                                   Margin="0,2,0,8" />
                        <StackPanel x:Name="PeriodLines" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DetailPeriodName}"
                                       FontSize="{StaticResource FontSize13}"
                                       Foreground="{DynamicResource text-primary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding DetailWeekName}"
                                       FontSize="{StaticResource FontSize13}"
                                       Foreground="{DynamicResource text-secondary}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="地点"
                                   Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailRoom}"
                                   FontSize="{StaticResource FontSize13}"
                                   Foreground="{DynamicResource text-primary}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="授课老师"
                                   Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailTeacher}"
                                   FontSize="{StaticResource FontSize13}"
                                   Foreground="{DynamicResource text-primary}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="上课周次"
                                   Style="{StaticResource HintText}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailWeeks}"
                                   FontSize="{StaticResource FontSize13}"
                                   Foreground="{DynamicResource text-primary}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>

                    <TextBlock Text="备注" Style="{StaticResource HintText}" Margin="0,18,0,6" />
                    <TextBox x:Name="NoteEditor"
                             Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="112"
                             VerticalScrollBarVisibility="Auto" Padding="8"
                             FontSize="{StaticResource FontSize13}"
                             Background="{DynamicResource bg-surface}"
                             Foreground="{DynamicResource text-primary}"
                             BorderBrush="{DynamicResource line}" />
                    <TextBlock Text="{Binding NoteHint}" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="清除备注" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearNoteCommand}" Margin="0,0,8,0" />
                        <Button Content="保存备注" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveNoteCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

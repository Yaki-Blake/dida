<UserControl x:Class="DidaLite.App.Views.YearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DidaLite.App.Views">

    <!-- 年视图：12 个迷你月历，点日期进日视图、点月份标题进月视图 -->
    <Border Margin="20,0,20,20"
            Background="{DynamicResource bg-surface}"
            BorderBrush="{DynamicResource line}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusM}">
        <DockPanel>
        <!-- 图例：颜色对应每天的日程数，0 项留白 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="16,10,16,0">
            <TextBlock Text="每天日程数" Style="{StaticResource MetaText}" Margin="0,0,10,0" />
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{DynamicResource heat-green}" Margin="0,0,4,0" />
            <TextBlock Text="1-2" Style="{StaticResource HintText}" Margin="0,0,10,0" />
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{DynamicResource heat-yellow}" Margin="0,0,4,0" />
            <TextBlock Text="3-6" Style="{StaticResource HintText}" Margin="0,0,10,0" />
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{DynamicResource heat-purple}" Margin="0,0,4,0" />
            <TextBlock Text="7-10" Style="{StaticResource HintText}" Margin="0,0,10,0" />
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{DynamicResource heat-red}" Margin="0,0,4,0" />
            <TextBlock Text="11+" Style="{StaticResource HintText}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding YearMonths}" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6,8,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="{Binding Title}"
                                        Style="{StaticResource GhostButton}"
                                        Padding="6,2"
                                        Command="{Binding DataContext.SelectYearMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />

                                <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                           Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                            </Grid>

                            <local:YearMonthDays
                                Days="{Binding Days}"
                                DayCommand="{Binding DataContext.SelectYearDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

<Window x:Class="DidaLite.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource bg-app}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg-surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,8">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <!-- 同步服务器：地址 + 账号 + 密码，点「登录」当场验证能不能连上 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="同步服务器" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RemoteUrlBox" Style="{StaticResource InputTextBox}"
                                 AutomationProperties.AutomationId="RemoteUrlBox" />

                        <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RemoteUserBox" Style="{StaticResource InputTextBox}"
                                 AutomationProperties.AutomationId="RemoteUserBox" />

                        <!-- 登录态下密码框整组隐藏；登出后重新出现 -->
                        <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="RemotePasswordBox" Style="{StaticResource InputPasswordBox}"
                                     AutomationProperties.AutomationId="RemotePasswordBox" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="LoginButton" Content="登录" Style="{StaticResource PrimaryButton}"
                                    Click="Login_Click" MinWidth="88"
                                    AutomationProperties.AutomationId="LoginButton" />
                            <Button x:Name="LogoutButton" Content="登出" Style="{StaticResource GhostButton}"
                                    Click="Logout_Click" MinWidth="88" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="LogoutButton" />
                            <TextBlock x:Name="ModeStatus" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="330" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 同步信息 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="同步信息" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="立即同步" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Command="{Binding SyncCommand}"
                                    AutomationProperties.AutomationId="SettingsSyncButton" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 快捷键 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="HotkeyButton" Style="{StaticResource GhostButton}"
                                    Click="HotkeyButton_Click"
                                    AutomationProperties.AutomationId="HotkeyButton"
                                    ToolTip="点击后按下想用的组合键，Esc 取消">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="唤起快捷键" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HotkeyText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource text-secondary}"
                                               AutomationProperties.AutomationId="HotkeyValue" />
                                </StackPanel>
                            </Button>

                            <!-- 开着的时候显示「关闭」，关掉之后变成「开启」，点一下按原组合恢复 -->
                            <Button x:Name="HotkeyToggleButton"
                                    Click="HotkeyToggle_Click"
                                    Margin="14,0,0,0"
                                    AutomationProperties.AutomationId="HotkeyToggleButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="关闭" />
                                        <Setter Property="ToolTip" Value="关掉全局快捷键，不再响应 Alt+D 之类的组合" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotkeyOff}" Value="True">
                                                <Setter Property="Content" Value="开启" />
                                                <Setter Property="ToolTip" Value="按关闭前的组合重新启用快捷键" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="开机自动启动" Style="{StaticResource FieldCheckBox}"
                                  IsChecked="{Binding IsAutoStart, Mode=TwoWay}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.AutomationId="AutoStartToggle" />
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="深色模式" Style="{StaticResource FieldCheckBox}"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.AutomationId="DarkModeToggle" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定：滚动区再长也不用滚到底才能关窗 -->
        <Border Grid.Row="1" Background="{DynamicResource bg-app}"
                BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Button Content="完成" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="88"
                    Click="Close_Click" />
        </Border>
    </Grid>
</Window>

<Window x:Class="DidaLite.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource bg-app}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg-surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,8">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="电脑是数据主库；手机填下面的地址和账号即可同步。"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,16" />

                <!-- 服务器地址 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="服务器地址" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="手机与电脑连同一个 Wi-Fi，把下面这个地址填到手机端。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBox}" />
                            <Button Grid.Column="1" Content="复制" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="CopyAddress_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存地址" Style="{StaticResource GhostButton}"
                                    Click="SaveAddress_Click" />
                            <TextBlock x:Name="AddressStatus" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 用户信息 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="用户信息" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="手机端同步要用这里的用户名和密码，账号保存在电脑的 MySQL 里。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UserNameBox" Style="{StaticResource InputTextBox}"
                                 AutomationProperties.AutomationId="UserNameBox" />

                        <TextBlock Text="密码（至少 6 位）" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"
                                     AutomationProperties.AutomationId="UserPasswordBox" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存账号" Style="{StaticResource PrimaryButton}"
                                    Click="SaveUser_Click" />
                        </StackPanel>

                        <TextBlock x:Name="UserStatus" Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 同步信息 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="同步信息" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="启动时会自动同步一次，也可以随时手动同步。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="立即同步" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Command="{Binding SyncCommand}"
                                    AutomationProperties.AutomationId="SettingsSyncButton" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 快捷键 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="点一下再按下组合键，用来随时唤出主窗口；Esc 取消。用不到时可以点右边「关闭」，下次启动也保持关闭。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HotkeyButton" Style="{StaticResource GhostButton}"
                                    Click="HotkeyButton_Click"
                                    AutomationProperties.AutomationId="HotkeyButton"
                                    ToolTip="点击后按下想用的组合键，Esc 取消">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="唤起快捷键" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HotkeyText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource text-secondary}"
                                               AutomationProperties.AutomationId="HotkeyValue" />
                                </StackPanel>
                            </Button>

                            <!-- 开着的时候显示「关闭」，关掉之后变成「开启」，点一下按原组合恢复 -->
                            <Button x:Name="HotkeyToggleButton"
                                    Click="HotkeyToggle_Click"
                                    Margin="14,0,0,0"
                                    AutomationProperties.AutomationId="HotkeyToggleButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="关闭" />
                                        <Setter Property="ToolTip" Value="关掉全局快捷键，不再响应 Alt+D 之类的组合" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotkeyOff}" Value="True">
                                                <Setter Property="Content" Value="开启" />
                                                <Setter Property="ToolTip" Value="按关闭前的组合重新启用快捷键" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="登录 Windows 后自动启动并收进托盘，之后双击图标是秒开。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <CheckBox Content="开机自动启动" Style="{StaticResource FieldCheckBox}"
                                  IsChecked="{Binding IsAutoStart, Mode=TwoWay}"
                                  Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="AutoStartToggle" />
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="深色模式" Style="{StaticResource FieldCheckBox}"
                                  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                  Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="DarkModeToggle" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定：滚动区再长也不用滚到底才能关窗 -->
        <Border Grid.Row="1" Background="{DynamicResource bg-app}"
                BorderBrush="{DynamicResource line}" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Button Content="完成" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" MinWidth="88"
                    Click="Close_Click" />
        </Border>
    </Grid>
</Window>

<Window x:Class="DidaLite.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DidaLite.App.Converters"
        xmlns:beh="clr-namespace:DidaLite.App.Behaviors"
        xmlns:views="clr-namespace:DidaLite.App.Views"
        Title="滴答 · DidaLite"
        Icon="/Assets/dida.ico"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource bg-app}">

    <Window.Resources>
        <conv:BrushKeyConverter x:Key="BrushKey" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="TaskRow">
            <Button Style="{StaticResource RowButton}"
                    Height="{StaticResource RowHeightCompact}"
                    Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource TimeColumn}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource TimeColumn}" />
                        <!-- 剩余空白留在最后，五栏才会挨在一起 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Style="{StaticResource TaskCheckBox}"
                              IsChecked="{Binding Done, Mode=OneWay}"
                              Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />

                    <!-- 开始时间 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StartText}"
                               Margin="10,0,0,0"
                               Style="{StaticResource MetaText}" />

                    <!-- 主题 -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               MaxWidth="{StaticResource TitleMaxWidth}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Typography.NumeralAlignment="Tabular">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="Foreground" Value="{DynamicResource text-tertiary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 地点：没填就整列收起，不留空档 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Location}"
                               MaxWidth="{StaticResource LocationMaxWidth}"
                               Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLocation}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 截止时间 -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding DueText}"
                               Margin="12,0,0,0"
                               TextAlignment="Left"
                               Style="{StaticResource MetaText}"
                               Foreground="{Binding DueBrushKey, Converter={StaticResource BrushKey}}" />
                </Grid>
            </Button>
        </DataTemplate>
        <!-- 分组列表的一行：组标题 + 任务行 + 空提示 -->
        <DataTemplate x:Key="GroupRow">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Header}"
                               Foreground="{Binding HeaderBrushKey, Converter={StaticResource BrushKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GroupHeader}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Header}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 只有可折叠的分组（逾期条数多）才出现这个按钮 -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Left"
                            Margin="4,0,0,0"
                            Padding="4,0"
                            Style="{StaticResource GhostButton}"
                            Content="{Binding ToggleLabel}"
                            FontSize="{StaticResource FontSize11}"
                            Command="{Binding ToggleCollapseCommand}"
                            Visibility="{Binding CanCollapse, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TaskRow}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyHint}" Margin="16,2,16,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="GroupedList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="4,0,4,16" />
            <Setter Property="ItemTemplate" Value="{StaticResource GroupRow}" />
        </Style>

        <!-- 日视图左侧课程带的一节课：一块实心卡片，和时间轴、日程块一样边界清楚 -->
        <DataTemplate x:Key="DayCourseBlock">
            <Border Background="Transparent"
                    Cursor="Hand"
                    ClipToBounds="True"
                    ToolTip="{Binding Tooltip}"
                    MouseLeftButtonUp="DayCourse_Click">
                <Border Background="{DynamicResource accent-weak}"
                        BorderBrush="{DynamicResource accent}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="{StaticResource RadiusS}"
                        Margin="0,1,5,1"
                        Padding="9,5,6,0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource FontSize12}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource text-primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TimeText}"
                                   FontFamily="{StaticResource NumericFont}"
                                   FontSize="{StaticResource FontSize11}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource text-secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding RoomText}"
                                   FontSize="{StaticResource FontSize11}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource text-secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowRoom, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding TeacherText}"
                                   FontSize="{StaticResource FontSize11}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource text-secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowTeacher, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <!-- 日视图右侧第一条竖带上的全天事件：不占时刻，从轴顶一直拉到轴底 -->
        <DataTemplate x:Key="AllDayBlock">
            <!-- Margin 放在按钮上、内容设成 Stretch：卡片和按钮底板严丝合缝，
                 按钮的鼠标悬停底色永远被卡片盖住，右侧不会漏出一块白框 -->
            <Button Style="{StaticResource TimelineBlockButton}"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,1,4,1"
                    Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Title}">
                <Border BorderBrush="{DynamicResource accent}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="{StaticResource RadiusS}"
                        Padding="9,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource accent-weak}" />
                            <Style.Triggers>
                                <!-- 悬停反馈做在卡片自己身上，不再让按钮底板露脸 -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource accent-weak-hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="全天"
                                   FontSize="{StaticResource FontSize11}"
                                   Foreground="{DynamicResource text-tertiary}" />
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{StaticResource FontSize13}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource text-primary}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Location}"
                                   FontSize="{StaticResource FontSize11}"
                                   Foreground="{DynamicResource text-secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- 日视图时间轴上的一块日程：块高即时长，点开是详情 -->
        <DataTemplate x:Key="TimelineBlock">
            <Button Style="{StaticResource TimelineBlockButton}"
                    Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Task}">
                <Border Background="{DynamicResource accent-weak}"
                        BorderBrush="{DynamicResource accent}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="{StaticResource RadiusS}"
                        Padding="8,4"
                        Margin="0,1,0,1">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding Task.Title}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                    <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
                                    <Setter Property="Foreground" Value="{DynamicResource text-primary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Task.Done}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="{DynamicResource text-tertiary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding MetaText}"
                                   FontSize="{StaticResource FontSize11}"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource text-secondary}"
                                   Visibility="{Binding ShowMeta, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- 侧栏可拖窄到 180px（默认仍是 272px），也能向右拖宽 -->
            <ColumnDefinition x:Name="SidebarColumn" Width="{StaticResource SidebarColumnWidth}" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <!-- 最小宽度由头部「标题 + 副标题」实际需要决定，见 UpdateMainColumnMinWidth -->
            <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Background="{DynamicResource bg-surface}"
                BorderBrush="{DynamicResource line}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="‹" Style="{StaticResource GhostButton}"
                                Padding="8,0" Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" Style="{StaticResource RowTitle}"
                                   FontSize="{StaticResource FontSize14}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="›" Style="{StaticResource GhostButton}"
                                Padding="8,0" Command="{Binding NextMonthCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WeekDays}" Margin="0,12,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 只缩不放大：侧栏拖窄时 34px 的日期圆圈按格宽等比缩小，最多紧挨、绝不互相重叠 -->
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <Button Style="{StaticResource CalendarDay}"
                                            Content="{Binding Day}"
                                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource line}" Margin="16,8,16,8" />

                <StackPanel Grid.Row="2">
                    <RadioButton Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding IsScheduleActive, Mode=OneWay}"
                                 Command="{Binding ShowScheduleSegmentCommand}">
                        <Grid>
                            <TextBlock Text="课表" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Schedule.EventsCount}" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding IsTodayActive, Mode=OneWay}"
                                 Command="{Binding ShowTodayCommand}">
                        <Grid>
                            <TextBlock Text="今天" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TodayCount}" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding IsAllActive, Mode=OneWay}"
                                 Command="{Binding ShowAllCommand}">
                        <Grid>
                            <TextBlock Text="全部" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AllCount}" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding IsDoneActive, Mode=OneWay}"
                                 Command="{Binding ShowDoneCommand}">
                        <Grid>
                            <TextBlock Text="已完成" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DoneCount}" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="16,0,16,16">
                    <Button Style="{StaticResource SettingsButton}"
                            Click="SettingsButton_Click"
                            AutomationProperties.AutomationId="SettingsButton"
                            ToolTip="服务器地址、用户信息、同步、快捷键与外观">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                            <TextBlock Text="设置" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侧栏与日程之间的分隔：10px 命中区，可左右拖动改变侧栏宽度，右极限由头部文字决定 -->
        <Thumb x:Name="SidebarSplitter"
               Grid.Column="1"
               Width="10"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="Transparent"
               Cursor="SizeWE"
               ToolTip="左右拖动调整左侧栏宽度"
               AutomationProperties.AutomationId="SidebarSplitter"
               DragStarted="SidebarSplitter_DragStarted"
               DragDelta="SidebarSplitter_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Grip" Width="2" Height="36"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource line}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ============ 主区 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Height="{StaticResource HeaderHeight}" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <!-- 左标题可压缩（副标题走省略号），右侧按钮组保持原宽。
                         这里千万别用 Auto 列：头部一长就会反过来把侧栏挤窄。 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="HeaderLeft" Grid.Column="0" VerticalAlignment="Center"
                      SizeChanged="Header_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MainTitle}" Style="{StaticResource PageTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MainSubtitle}" Style="{StaticResource MetaText}"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="HeaderRight" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            SizeChanged="Header_SizeChanged">
                    <Button Command="{Binding ToggleAllWeeksCommand}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Content" Value="{Binding WeekToggleAllText}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMonthView}" Value="True" />
                                            <Condition Binding="{Binding HasExpandableWeek}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 一键完成：今天 / 全部视图先清逾期，其余视图清选中日。
                         放在「日/周/月/年」段控左边，靠近标题那一侧 -->
                    <Button Style="{StaticResource GhostButton}"
                            Content="{Binding BulkDoneText}"
                            Command="{Binding CompleteListedCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanBulkDone, Converter={StaticResource BoolToVis}}"
                            ToolTip="把逾期（或选中日）的未完成日程全部打勾，两秒内可撤销" />

                    <Border Background="{DynamicResource bg-surface}"
                            BorderBrush="{DynamicResource line}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusM}" Padding="2">
                        <Grid x:Name="SegmentBar">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ScheduleSegmentButton"
                                        Content="课表" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsScheduleSegment}"
                                        CommandParameter="schedule"
                                        Click="Segment_Click" />
                                <Button x:Name="DaySegmentButton"
                                        Content="日" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsDaySegment}"
                                        CommandParameter="day"
                                        Click="Segment_Click" />
                                <Button x:Name="WeekSegmentButton"
                                        Content="周" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsWeekSegment}"
                                        CommandParameter="week"
                                        Click="Segment_Click" />
                                <Button x:Name="MonthSegmentButton"
                                        Content="月" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsMonthSegment}"
                                        CommandParameter="month"
                                        Click="Segment_Click" />
                                <Button x:Name="YearSegmentButton"
                                        Content="年" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsYearSegment}"
                                        CommandParameter="year"
                                        Click="Segment_Click" />
                                <Button x:Name="FocusSegmentButton"
                                        Content="专注" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsFocusSegment}"
                                        CommandParameter="focus"
                                        Click="Segment_Click" />
                                <Button x:Name="NotesSegmentButton"
                                        Content="便签" Style="{StaticResource SegmentButton}"
                                        Tag="{Binding IsNotesSegment}"
                                        CommandParameter="notes"
                                        Click="Segment_Click" />
                            </StackPanel>

                            <!-- 切换时从旧按钮飞向新按钮的绿色小圆点 -->
                            <Canvas x:Name="SegmentDotLayer" IsHitTestVisible="False">
                                <Border x:Name="SegmentDot"
                                        Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource accent}"
                                        RenderTransformOrigin="0.5,0.5"
                                        Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SegmentDotScale" />
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Button Content="同步" Style="{StaticResource GhostButton}"
                            beh:PressFeedback.Enabled="True"
                            Command="{Binding SyncCommand}" Margin="8,0,0,0" />

                    <Button Content="+ 添加" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewTaskCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 内容区：切换视图时做水平翻页动画 -->
            <Grid x:Name="ContentHost" Grid.Row="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentSlide" />
                </Grid.RenderTransform>

                <!-- 日视图：左边天空色时间轴，右边按时刻绝对定位的日程块 -->
                <ScrollViewer x:Name="TimelineScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsTimelineView, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,6,24">
                        <!-- 逾期 / 未排时间 -->
                        <ItemsControl ItemsSource="{Binding TimelineGroups}" Style="{StaticResource GroupedList}" />

                        <Grid Height="{Binding TimelineHeight}" Margin="8,0,8,0" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <!-- 导入课表后左边让出一节课的宽度，时间轴整体右移；没导入时收成 0 -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                                <!-- 全天事件竖带：没有全天事件时收成 0 -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <views:DaySkyBoard Grid.ColumnSpan="4"
                                               RulerWidth="64"
                                               LaneWidth="{Binding CourseLaneWidth}"
                                               StartHour="{Binding TimelineStartHour}"
                                               EndHour="{Binding TimelineEndHour}"
                                               HourHeight="{Binding TimelineHourHeight}"
                                               NowHour="{Binding TimelineNowHour}"
                                               IsDark="{Binding IsDark}" />

                            <!-- 课程带：一节课一条渐渐淡去的色带，位置与右边日程块同一套刻度 -->
                            <Grid Grid.Column="0"
                                  Width="{Binding CourseLaneWidth}"
                                  Visibility="{Binding ShowCourseLane, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding DayCourses}"
                                              ItemTemplate="{StaticResource DayCourseBlock}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:CourseLanePanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <TextBlock Text="这天没课"
                                           Style="{StaticResource HintText}"
                                           Margin="12,8,0,0"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding IsCourseLaneEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- 全天事件：紧贴时间轴右侧的第一条竖带，从轴顶拉到轴底。
                                 宽度不给死值：Auto 列按卡片内容量出来，题目多宽竖带就多宽，
                                 只留上下限——太窄撑不住，太长就把时间轴挤没了（超了自动换行） -->
                            <ItemsControl Grid.Column="2"
                                          MinWidth="{Binding AllDayLaneMinWidth}"
                                          MaxWidth="{Binding AllDayLaneMaxWidth}"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding AllDayItems}"
                                          ItemTemplate="{StaticResource AllDayBlock}"
                                          Visibility="{Binding HasAllDayItems, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <ItemsControl Grid.Column="3"
                                          ItemsSource="{Binding TimelineBlocks}"
                                          ItemTemplate="{StaticResource TimelineBlock}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:TimelinePanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 列表 / 周视图：各用一份容器，来回切换时不重建 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}" Style="{StaticResource GroupedList}" />
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl x:Name="WeekList" ItemsSource="{Binding WeekGroups}" Style="{StaticResource GroupedList}" />
                </ScrollViewer>

                <!-- 月 / 年 / 专注 / 课表：首次切过去才创建，启动时只留占位 -->
                <ContentControl x:Name="MonthHost" Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVis}}" />
                <ContentControl x:Name="YearHost" Visibility="{Binding IsYearView, Converter={StaticResource BoolToVis}}" />
                <ContentControl x:Name="FocusHost" Visibility="{Binding IsFocusView, Converter={StaticResource BoolToVis}}" />
                <ContentControl x:Name="ScheduleHost" Visibility="{Binding IsScheduleView, Converter={StaticResource BoolToVis}}" />
                <ContentControl x:Name="NotesHost" Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}" />

                <!-- 空态（列表视图） -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="这里还没有任务" Style="{StaticResource SectionTitle}"
                               Foreground="{DynamicResource text-secondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="点击右上角「添加」新建任务" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 撤销条 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                        Background="{DynamicResource bg-surface}"
                        BorderBrush="{DynamicResource line}" BorderThickness="1"
                        CornerRadius="8" Padding="12,6"
                        Effect="{DynamicResource OverlayShadow}"
                        Visibility="{Binding IsUndoVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UndoText}" Style="{StaticResource MetaText}" />
                        <Button Content="撤销" Style="{StaticResource GhostButton}"
                                Command="{Binding UndoCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 详情 / 新建 ============ -->
        <Border x:Name="DetailPanel"
                Grid.Column="3"
                Width="{StaticResource DetailWidth}"
                Background="{DynamicResource bg-surface}"
                BorderBrush="{DynamicResource line}"
                BorderThickness="1,0,0,0"
                Opacity="0"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailSlide" X="24" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,8">
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Command="{Binding CloseDetailCommand}" Padding="8,0" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="主题" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource InputTextBox}"
                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="地点" Style="{StaticResource HintText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="全天事件" Style="{StaticResource FieldCheckBox}"
                                  Margin="0,14,0,0"
                                  IsChecked="{Binding EditAllDay, Mode=TwoWay}" />

                        <TextBlock Text="起始时间" Style="{StaticResource HintText}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}"
                                     Text="{Binding EditStartDate, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                     IsEnabled="{Binding IsTimed}"
                                     LostFocus="TimeBox_LostFocus"
                                     Text="{Binding EditStartTime, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="截止时间" Style="{StaticResource HintText}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}"
                                     Text="{Binding EditDueDate, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}"
                                     IsEnabled="{Binding IsTimed}"
                                     LostFocus="TimeBox_LostFocus"
                                     Text="{Binding EditDueTime, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="重复" Style="{StaticResource HintText}" Margin="0,12,0,4" />
                        <ComboBox Style="{StaticResource SelectComboBox}"
                                  ItemsSource="{Binding RepeatLabels}"
                                  SelectedIndex="{Binding EditRepeatIndex, Mode=TwoWay}" />

                        <TextBlock Text="正文" Style="{StaticResource HintText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Height="120"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Padding="10,8"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,12,16,16">
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveDetailCommand}" />
                    <Button Content="删除" Style="{StaticResource DangerGhostButton}"
                            x:Name="DeleteButton"
                            Click="Delete_Click" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 同步浮层：贴着右上角「同步 / 添加」下方往下排，绿底白字、底边走 4 秒进度条，
             走完自己向上淡出；点一下立刻收起。位置对齐头部右边距（20） -->
        <Canvas x:Name="SyncToastLayer"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,62,20,0"
                Panel.ZIndex="99" />

        <!-- 删除特效层：粒子画在全窗最上面，不吃鼠标 -->
        <Canvas x:Name="FxLayer"
                Grid.ColumnSpan="4"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Panel.ZIndex="100" />

        <!-- 键盘删除确认：按 Enter 确认，Esc 取消 -->
        <Border x:Name="ConfirmBar"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="{DynamicResource bg-surface}"
                BorderBrush="{DynamicResource line}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusM}"
                Padding="16,10"
                Visibility="Collapsed"
                Panel.ZIndex="101">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ConfirmText" Style="{StaticResource MetaText}"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="按 Enter 确认 · Esc 取消"
                           Style="{StaticResource HintText}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

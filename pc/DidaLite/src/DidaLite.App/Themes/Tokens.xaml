<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ============ 设计令牌（计划书 6.2） ============ -->

    <!-- 字体 -->
    <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="NumericFont">Consolas</FontFamily>

    <!-- 字号 -->
    <sys:Double x:Key="FontSize11">11</sys:Double>
    <sys:Double x:Key="FontSize12">12</sys:Double>
    <sys:Double x:Key="FontSize13">13</sys:Double>
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize28">28</sys:Double>
    <sys:Double x:Key="FontSizeHero">56</sys:Double>

    <!-- 间距 -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>

    <!-- 圆角 -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- 尺寸 -->
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <!-- 日程列表一行：五栏信息横排，行高比地址栏等普通行更紧凑 -->
    <sys:Double x:Key="RowHeightCompact">32</sys:Double>
    <sys:Double x:Key="SidebarWidth">278</sys:Double>
    <!-- 列宽只认 GridLength，不能直接拿上面的 Double -->
    <GridLength x:Key="SidebarColumnWidth">278</GridLength>
    <sys:Double x:Key="DetailWidth">300</sys:Double>
    <sys:Double x:Key="HeaderHeight">56</sys:Double>
    <sys:Double x:Key="CalendarCell">34</sys:Double>
    <!-- 年视图一行 7 列要塞进 1/3 主区宽，格子比侧栏日历小一号 -->
    <sys:Double x:Key="YearCalendarCell">24</sys:Double>
    <sys:Double x:Key="CheckBoxSize">18</sys:Double>
    <sys:Double x:Key="TimeColumnWidth">64</sys:Double>
    <!-- 时间列宽只认 GridLength，不能直接拿上面的 Double -->
    <GridLength x:Key="TimeColumn">64</GridLength>
    <!-- 列表行内主题、地点的最大宽度：超出省略，保证五栏挨在一起而不是撑到两端 -->
    <sys:Double x:Key="TitleMaxWidth">300</sys:Double>
    <sys:Double x:Key="LocationMaxWidth">120</sys:Double>
    <sys:Double x:Key="MonthToggleWidth">22</sys:Double>

    <!-- 行内距：左右 16，控件间 8 -->
    <Thickness x:Key="RowPadding">16,0,16,0</Thickness>
    <Thickness x:Key="RowContentMargin">8,0,0,0</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
</ResourceDictionary>
